<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- The day's numbers, as the app last sent them. -->
    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout style="@style/QuickWidgetStat">
            <TextView android:id="@+id/widget_kcal" style="@style/QuickWidgetValue" android:textColor="#FF4ADE80" android:text="—" />
            <TextView android:id="@+id/widget_kcal_label" style="@style/QuickWidgetLabel" android:text="kcal" />
        </LinearLayout>

        <LinearLayout style="@style/QuickWidgetStat">
            <TextView android:id="@+id/widget_water_value" style="@style/QuickWidgetValue" android:textColor="#FF38BDF8" android:text="—" />
            <TextView android:id="@+id/widget_water_label" style="@style/QuickWidgetLabel" android:text="de água" />
        </LinearLayout>

        <LinearLayout style="@style/QuickWidgetStat">
            <TextView android:id="@+id/widget_next" style="@style/QuickWidgetValue" android:textColor="#FFFB923C" android:text="—" />
            <TextView android:id="@+id/widget_next_label" style="@style/QuickWidgetLabel" android:text="próximo treino" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_food"
            style="@style/QuickWidgetButton"
            android:text="@string/shortcut_food" />

        <TextView
            android:id="@+id/widget_water"
            style="@style/QuickWidgetButton"
            android:text="@string/shortcut_water" />

        <TextView
            android:id="@+id/widget_workout"
            style="@style/QuickWidgetButton"
            android:text="@string/shortcut_workout" />

        <TextView
            android:id="@+id/widget_weight"
            style="@style/QuickWidgetButton"
            android:text="@string/shortcut_weight" />
    </LinearLayout>
</LinearLayout>
