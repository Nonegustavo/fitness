<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: calories left and the next workout, the macros and the water against the
     goals, and the daily shortcuts. QuickWidget fills it with what the app last sent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Calories and the next workout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_kcal_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/QuickWidgetIcon"
                android:background="@drawable/widget_tile_food"
                android:src="@drawable/widget_ic_utensils"
                android:tint="#FF4ADE80" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_kcal"
                        style="@style/QuickWidgetValue"
                        android:text="—" />

                    <TextView
                        android:id="@+id/widget_kcal_label"
                        style="@style/QuickWidgetLabel"
                        android:layout_marginStart="4dp"
                        android:text="kcal" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_kcal_bar"
                        style="@style/QuickWidgetBar.Large"
                        android:progressDrawable="@drawable/widget_bar_food" />

                    <!-- Over the goal: the full bar in amber instead. -->
                    <ProgressBar
                        android:id="@+id/widget_kcal_bar_over"
                        style="@style/QuickWidgetBar.Large"
                        android:progress="1000"
                        android:progressDrawable="@drawable/widget_bar_over"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_kcal_detail"
                    style="@style/QuickWidgetLabel"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_next_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_next_icon"
                style="@style/QuickWidgetIcon"
                android:background="@drawable/widget_tile_training"
                android:src="@drawable/widget_ic_dumbbell"
                android:tint="#FFFB923C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_next"
                    style="@style/QuickWidgetTitle"
                    android:text="—" />

                <TextView
                    android:id="@+id/widget_next_label"
                    style="@style/QuickWidgetLabel"
                    android:text="próximo treino" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The macros and the water against the goals. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_macros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="horizontal">

            <LinearLayout style="@style/QuickWidgetMeter">

                <LinearLayout style="@style/QuickWidgetMeterRow">

                    <TextView
                        style="@style/QuickWidgetMeterName"
                        android:text="Carb"
                        android:textColor="#FF4294EC" />

                    <TextView
                        android:id="@+id/widget_carbs"
                        style="@style/QuickWidgetMeterValue" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_carbs_bar"
                    style="@style/QuickWidgetBar"
                    android:progressDrawable="@drawable/widget_bar_carbs" />
            </LinearLayout>

            <LinearLayout style="@style/QuickWidgetMeter">

                <LinearLayout style="@style/QuickWidgetMeterRow">

                    <TextView
                        style="@style/QuickWidgetMeterName"
                        android:text="Prot"
                        android:textColor="#FFA585F5" />

                    <TextView
                        android:id="@+id/widget_protein"
                        style="@style/QuickWidgetMeterValue" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_protein_bar"
                    style="@style/QuickWidgetBar"
                    android:progressDrawable="@drawable/widget_bar_protein" />
            </LinearLayout>

            <LinearLayout style="@style/QuickWidgetMeter">

                <LinearLayout style="@style/QuickWidgetMeterRow">

                    <TextView
                        style="@style/QuickWidgetMeterName"
                        android:text="Gord"
                        android:textColor="#FFF2AC45" />

                    <TextView
                        android:id="@+id/widget_fat"
                        style="@style/QuickWidgetMeterValue" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_fat_bar"
                    style="@style/QuickWidgetBar"
                    android:progressDrawable="@drawable/widget_bar_fat" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_water_box"
            style="@style/QuickWidgetMeter"
            android:layout_marginEnd="0dp">

            <LinearLayout style="@style/QuickWidgetMeterRow">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_ic_glass_water"
                    android:tint="#FF38BDF8" />

                <TextView
                    android:id="@+id/widget_water_value"
                    style="@style/QuickWidgetMeterValue" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_water_bar"
                style="@style/QuickWidgetBar"
                android:progressDrawable="@drawable/widget_bar_water" />
        </LinearLayout>
    </LinearLayout>

    <!-- The shortcuts, each with its section's icon. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_food"
            style="@style/QuickWidgetButton">

            <ImageView
                style="@style/QuickWidgetButtonIcon"
                android:src="@drawable/widget_ic_utensils"
                android:tint="#FF4ADE80" />

            <TextView
                style="@style/QuickWidgetButtonText"
                android:text="@string/shortcut_food" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_water"
            style="@style/QuickWidgetButton">

            <ImageView
                style="@style/QuickWidgetButtonIcon"
                android:src="@drawable/widget_ic_glass_water"
                android:tint="#FF38BDF8" />

            <TextView
                style="@style/QuickWidgetButtonText"
                android:text="@string/shortcut_water" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_workout"
            style="@style/QuickWidgetButton">

            <ImageView
                style="@style/QuickWidgetButtonIcon"
                android:src="@drawable/widget_ic_dumbbell"
                android:tint="#FFFB923C" />

            <TextView
                style="@style/QuickWidgetButtonText"
                android:text="@string/shortcut_workout" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_weight"
            style="@style/QuickWidgetButton">

            <ImageView
                style="@style/QuickWidgetButtonIcon"
                android:src="@drawable/widget_ic_scale"
                android:tint="#FFE879F9" />

            <TextView
                style="@style/QuickWidgetButtonText"
                android:text="@string/shortcut_weight" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
